bot_name=your-bot-name
bot_id=your-webhook-key
bot_token=your-token
bot_aes_key=your-aes-key
corp_id=your-corp-id

# 委托单导入接口（multipart 上传文件 + folderno）
ANALYZE_API_URL=https://online.cticert.com/fdd/api/Fdd/WecomOfflineImport
ANALYZE_API_FILE_FIELD=file
ANALYZE_API_FOLDERNO_FIELD=folderno
# ANALYZE_API_TOKEN=
# ANALYZE_RESULT_KEY=result
ANALYZE_TIMEOUT=120
# 导入接口侧 WAF 会拦截默认 python-requests UA，代码已默认伪装为浏览器；如需自定义可设置：
# ANALYZE_API_USER_AGENT=
# 上传文件大小上限（MB）
ANALYZE_MAX_FILE_SIZE_MB=50

# stream（推荐/默认）：被动流式回复，客户端轮询获取进度，适合长耗时导入；
# async：后台处理后经 response_url 主动推送（每条消息仅一次、1小时有效）
REPLY_MODE=stream
